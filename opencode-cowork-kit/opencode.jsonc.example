{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/muse-spark-1.3-contributor-free",
  "plugin": ["openslimedit@latest"],
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp"
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app"
    },
    "crawlbase": {
      "type": "local",
      "command": ["npx", "-y", "@crawlbase/mcp@latest"],
      "enabled": true,
      "environment": {
        "CRAWLBASE_TOKEN": "{env:CRAWLBASE_TOKEN}",
        "CRAWLBASE_JS_TOKEN": "{env:CRAWLBASE_JS_TOKEN}"
      }
    },
    "screenshot": {
      "type": "local",
      "command": ["python", "C:/Users/<YOUR_USERNAME>/.config/opencode/mcp/screenshot-server/server.py"],
      "enabled": true
    },
    "memory": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-memory"],
      "enabled": true
    },
    "thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },
  "formatter": true,
  "agent": {
    "plan": { "color": "#A0785A" },
    "deep-search": { "color": "#1B6B93" }
  }
}
