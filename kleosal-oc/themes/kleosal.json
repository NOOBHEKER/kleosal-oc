{
  "$schema": "https://opencode.ai/theme.json",
  "_attribution": "​​agastyas shii​​ · github.com/agastyas-shii",
  "defs": {
    "bg0": "#0e0e18",
    "bg1": "#131320",
    "bg2": "#1a1a2a",
    "fg0": "#d0d0d8",
    "fg1": "#6b6b8a",
    "lav0": "#E6E6FA",
    "lav1": "#b48ead",
    "teal": "#88c0d0",
    "border0": "#2a2a40",
    "green": "#a3be8c",
    "red": "#bf616a",
    "amber": "#ebcb8b",
    "lbg0": "#ebe5db",
    "lbg1": "#e3ddd3",
    "lbg2": "#dbd5cb",
    "lfg0": "#4a4a58",
    "lfg1": "#9a9aaa",
    "llav0": "#4a3f6b",
    "llav1": "#6b5b8a",
    "lteal": "#5a8a7a",
    "lborder0": "#d5cfc3",
    "lgreen": "#5a8a4a",
    "lred": "#c94040",
    "lamber": "#c9a030"
  },
  "theme": {
    "primary": { "dark": "lav0", "light": "llav0" },
    "secondary": { "dark": "lav1", "light": "llav1" },
    "accent": { "dark": "teal", "light": "lteal" },
    "error": { "dark": "red", "light": "lred" },
    "warning": { "dark": "amber", "light": "lamber" },
    "success": { "dark": "green", "light": "lgreen" },
    "info": { "dark": "teal", "light": "lteal" },
    "text": { "dark": "fg0", "light": "lfg0" },
    "textMuted": { "dark": "fg1", "light": "lfg1" },
    "textEmphasized": { "dark": "lav0", "light": "llav0" },
    "background": { "dark": "bg0", "light": "lbg0" },
    "backgroundSecondary": { "dark": "bg1", "light": "lbg1" },
    "backgroundPanel": { "dark": "bg1", "light": "lbg1" },
    "backgroundElement": { "dark": "bg2", "light": "lbg2" },
    "border": { "dark": "border0", "light": "lborder0" },
    "borderActive": { "dark": "lav0", "light": "llav0" },
    "borderSubtle": { "dark": "border0", "light": "lborder0" },
    "borderDim": { "dark": "border0", "light": "lborder0" },
    "diffAdded": { "dark": "green", "light": "lgreen" },
    "diffRemoved": { "dark": "red", "light": "lred" },
    "diffContext": { "dark": "fg1", "light": "lfg1" },
    "diffHunkHeader": { "dark": "fg1", "light": "lfg1" },
    "diffHighlightAdded": { "dark": "#bdae6e", "light": "#4a7a3a" },
    "diffHighlightRemoved": { "dark": "#d08770", "light": "#b93030" },
    "diffAddedBg": { "dark": "bg1", "light": "lbg1" },
    "diffRemovedBg": { "dark": "bg1", "light": "lbg1" },
    "diffContextBg": { "dark": "bg0", "light": "lbg0" },
    "diffLineNumber": { "dark": "fg1", "light": "lfg1" },
    "diffAddedLineNumberBg": { "dark": "bg2", "light": "lbg2" },
    "diffRemovedLineNumberBg": { "dark": "bg2", "light": "lbg2" },
    "markdownText": { "dark": "fg0", "light": "lfg0" },
    "markdownHeading": { "dark": "lav0", "light": "llav0" },
    "markdownLink": { "dark": "teal", "light": "lteal" },
    "markdownLinkText": { "dark": "lav0", "light": "llav0" },
    "markdownCode": { "dark": "green", "light": "lgreen" },
    "markdownCodeBlock": { "dark": "fg0", "light": "lfg0" },
    "markdownBlockQuote": { "dark": "fg1", "light": "lfg1" },
    "markdownEmph": { "dark": "amber", "light": "lamber" },
    "markdownStrong": { "dark": "lav0", "light": "llav0" },
    "markdownHorizontalRule": { "dark": "border0", "light": "lborder0" },
    "markdownListItem": { "dark": "teal", "light": "lteal" },
    "markdownListEnumeration": { "dark": "lav1", "light": "llav1" },
    "markdownImage": { "dark": "teal", "light": "lteal" },
    "markdownImageText": { "dark": "lav1", "light": "llav1" },
    "syntaxComment": { "dark": "fg1", "light": "lfg1" },
    "syntaxKeyword": { "dark": "lav0", "light": "llav0" },
    "syntaxFunction": { "dark": "teal", "light": "lteal" },
    "syntaxVariable": { "dark": "lav1", "light": "llav1" },
    "syntaxString": { "dark": "green", "light": "lgreen" },
    "syntaxNumber": { "dark": "amber", "light": "lamber" },
    "syntaxType": { "dark": "lav0", "light": "llav0" },
    "syntaxOperator": { "dark": "teal", "light": "lteal" },
    "syntaxPunctuation": { "dark": "fg0", "light": "lfg0" }
  }
}
